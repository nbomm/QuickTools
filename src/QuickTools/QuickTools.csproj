<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Shell icon rects, Screen bounds and menu sizes must all be in the same physical pixels. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>QuickTools</RootNamespace>
    <!-- CI releases use Major.Minor from here and the workflow run number as the patch (1.0.<run>).
         Bump this to start a new minor or major series. -->
    <VersionPrefix>1.0.0</VersionPrefix>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="QuickTools.Tests" />
  </ItemGroup>

</Project>
