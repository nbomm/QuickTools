<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Shell icon rects, Screen bounds and menu sizes must all be in the same physical pixels. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>QuickTools</RootNamespace>
    <!-- CI releases use Major.Minor from here and the workflow run number as the patch (1.1.<run>).
         Bump this to start a new minor or major series. -->
    <VersionPrefix>1.1.0</VersionPrefix>
    <!-- Shown in the Settings header and in the exe's Properties > Details. -->
    <Copyright>Copyright © 2026 Nathan Bommersbach</Copyright>
    <!-- Generated from AppIcon.Draw by tools/Generate-AppIcon.ps1, so it matches the tray icon. -->
    <ApplicationIcon>QuickTools.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="QuickTools.Tests" />
  </ItemGroup>

</Project>
